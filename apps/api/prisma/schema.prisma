generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}









model User {
  id            String         @id @default(cuid())
  displayName   String?
  email         String?        @unique
  phone         String?        @unique
  phoneVerified Boolean        @default(false)
  avatarUrl     String?
  locale        String         @default("fa")
  theme         String         @default("light")
  role          String         @default("user")
  /// active | suspended | banned
  status        String         @default("active")
  suspendedAt   DateTime?
  suspendedReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  identities    AuthIdentity[]
  sessions      Session[]
  wallet        Wallet?
  enrollments   Enrollment[]
  progress      LessonProgress[]
  submissions   Submission[]
  orders        Order[]
  subscriptions Subscription[]
  liveRegs      LiveRegistration[]
  otpCodes      OtpCode[]
  tickets      Ticket[]        @relation("TicketAuthor")
  assignedTickets Ticket[]     @relation("TicketAssignee")
  ticketMessages TicketMessage[]
  staffNotes    StaffNote[]
}

model AuthIdentity {
  id             String       @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  client    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String?
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone])
}

model Track {
  id        String        @id @default(cuid())
  slug      String        @unique
  yearPlan  Int
  status    String @default("draft")
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  i18n      TrackI18n[]
  courses   Course[]
  seo       SeoMeta?
}

model TrackI18n {
  id          String @id @default(cuid())
  trackId     String
  locale      String
  title       String
  summary     String
  description String @default("")
  track       Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, locale])
}

model Course {
  id                   String        @id @default(cuid())
  trackId              String
  slug                 String        @unique
  status               String @default("draft")
  accessTier           String    @default("paid")
  priceCents           Int           @default(0)
  currency             String        @default("IRT")
  sortOrder            Int           @default(0)
  estimatedMinutes     Int           @default(0)
  sku                  String?
  coverUrl             String?
  featured             Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  track                Track         @relation(fields: [trackId], references: [id], onDelete: Cascade)
  i18n                 CourseI18n[]
  modules              Module[]
  enrollments          Enrollment[]
  seo                  SeoMeta?
  taxonomies           CourseTerm[]
}

model CourseI18n {
  id          String @id @default(cuid())
  courseId    String
  locale      String
  title       String
  summary     String
  description String @default("")
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, locale])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  slug      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  i18n      ModuleI18n[]
  lessons   Lesson[]

  @@unique([courseId, slug])
}

model ModuleI18n {
  id       String @id @default(cuid())
  moduleId String
  locale   String
  title    String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, locale])
}

model Lesson {
  id                   String        @id @default(cuid())
  moduleId             String
  slug                 String
  status               String @default("draft")
  isFreePreview        Boolean       @default(false)
  sortOrder            Int           @default(0)
  durationSeconds      Int           @default(0)
  youtubeUrl           String?
  aparatUrl            String?
  podcastUrl           String?
  instagramPermalink   String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  module               Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  i18n                 LessonI18n[]
  assets               ContentAsset[]
  progress             LessonProgress[]
  seo                  SeoMeta?

  @@unique([moduleId, slug])
}

model LessonI18n {
  id       String @id @default(cuid())
  lessonId String
  locale   String
  title    String
  summary  String @default("")
  bodyMdx  String @default("")
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, locale])
}

model ContentAsset {
  id       String    @id @default(cuid())
  lessonId String?
  type     String
  url      String
  mimeType String?
  metaJson String    @default("{}")
  lesson   Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
}

model Article {
  id            String        @id @default(cuid())
  slug          String        @unique
  status        String @default("draft")
  publishedAt   DateTime?
  authorId      String?
  /// Featured image (WordPress-style)
  coverUrl      String?
  /// Internal hero / banner above post content
  bannerUrl     String?
  /// Sticky / pinned to front of lists (WP sticky)
  sticky        Boolean       @default(false)
  commentStatus String        @default("open")
  /// RankMath-style focus keyword
  focusKeyword  String        @default("")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  i18n          ArticleI18n[]
  seo           SeoMeta?
  taxonomies    ArticleTerm[]
  comments      Comment[]
}

model ArticleI18n {
  id        String  @id @default(cuid())
  articleId String
  locale    String
  title     String
  summary   String
  bodyMdx   String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
}

model PodcastEpisode {
  id          String        @id @default(cuid())
  slug        String        @unique
  status      String @default("draft")
  audioUrl    String
  durationSec Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  i18n        PodcastI18n[]
  seo         SeoMeta?
}

model PodcastI18n {
  id        String         @id @default(cuid())
  podcastId String
  locale    String
  title     String
  summary   String
  podcast   PodcastEpisode @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([podcastId, locale])
}

model SeoMeta {
  id              String  @id @default(cuid())
  locale          String
  entityType      String
  entityId        String
  metaTitle       String
  metaDescription String
  canonicalPath   String?
  ogImageUrl      String?
  noIndex         Boolean @default(false)
  schemaJson      String  @default("{}")

  trackId   String? @unique
  courseId  String? @unique
  lessonId  String? @unique
  articleId String? @unique
  podcastId String? @unique
  liveId    String? @unique
  pageId    String? @unique

  track   Track?          @relation(fields: [trackId], references: [id], onDelete: Cascade)
  course  Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson  Lesson?         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  article Article?        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  podcast PodcastEpisode? @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  live    LiveEvent?      @relation(fields: [liveId], references: [id], onDelete: Cascade)
  page    Page?           @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId, locale])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  source    String   @default("purchase")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id             String   @id @default(cuid())
  userId         String
  lessonId       String
  completed      Boolean  @default(false)
  progressPct    Int      @default(0)
  lastPositionSec Int     @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique
  intervalDays Int
  priceCents   Int
  currency     String   @default("IRT")
  active       Boolean  @default(true)
  i18nJson     String   @default("{}")
  subscriptions Subscription[]
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  status    String
  startsAt  DateTime
  endsAt    DateTime
  autoRenew Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan     @relation(fields: [planId], references: [id])

  @@index([userId, status])
}

model Order {
  id            String   @id @default(cuid())
  userId        String
  kind          String
  amountCents   Int
  tokenSpent    Int      @default(0)
  currency      String   @default("IRT")
  /// pending | processing | completed | on_hold | cancelled | refunded | failed
  status        String
  productId     String?
  planId        String?
  couponId      String?
  discountCents Int      @default(0)
  refundCents   Int      @default(0)
  paidAt        DateTime?
  refundedAt    DateTime?
  customerNote  String   @default("")
  billingJson   String   @default("{}")
  metaJson      String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon        Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  notes         OrderNote[]

  @@index([userId])
  @@index([status, createdAt])
}

model Wallet {
  id        String        @id @default(cuid())
  userId    String        @unique
  balance   Int           @default(0)
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger    LedgerEntry[]
}

model LedgerEntry {
  id        String     @id @default(cuid())
  walletId  String
  type      String
  amount    Int
  reason    String
  refType   String?
  refId     String?
  createdAt DateTime   @default(now())
  wallet    Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model Challenge {
  id          String        @id @default(cuid())
  slug        String        @unique
  status      String @default("draft")
  difficulty  String        @default("easy")
  language    String        @default("javascript")
  points      Int           @default(100)
  timeLimitMs Int           @default(5000)
  createdAt   DateTime      @default(now())
  i18n        ChallengeI18n[]
  tests       TestCase[]
  submissions Submission[]
}

model ChallengeI18n {
  id          String    @id @default(cuid())
  challengeId String
  locale      String
  title       String
  promptMdx   String
  starterCode String    @default("")
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, locale])
}

model TestCase {
  id          String    @id @default(cuid())
  challengeId String
  inputJson   String
  outputJson  String
  isHidden    Boolean   @default(false)
  sortOrder   Int       @default(0)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model Submission {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  code        String
  passed      Boolean  @default(false)
  score       Int      @default(0)
  tokensEarned Int     @default(0)
  resultJson  String   @default("{}")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId, challengeId])
}

model LiveEvent {
  id            String        @id @default(cuid())
  slug          String        @unique
  status        String    @default("scheduled")
  startsAt      DateTime
  endsAt        DateTime?
  ingestUrl     String?
  playbackUrl   String?
  recordingUrl  String?
  destinationsJson String     @default("[]")
  externalUrlsJson String     @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  i18n          LiveI18n[]
  registrations LiveRegistration[]
  seo           SeoMeta?
}

model LiveI18n {
  id          String    @id @default(cuid())
  liveId      String
  locale      String
  title       String
  summary     String
  description String    @default("")
  live        LiveEvent @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@unique([liveId, locale])
}

model LiveRegistration {
  id        String    @id @default(cuid())
  userId    String
  liveId    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  live      LiveEvent @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@unique([userId, liveId])
}

model Redirect {
  id       String @id @default(cuid())
  fromPath String @unique
  toPath   String
  code     Int    @default(301)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

/// Support / helpdesk ticket
model Ticket {
  id           String    @id @default(cuid())
  userId       String
  assignedToId String?
  subject      String
  category     String    @default("other")
  priority     String    @default("normal")
  status       String    @default("open")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  closedAt     DateTime?

  user      User            @relation("TicketAuthor", fields: [userId], references: [id], onDelete: Cascade)
  assignee  User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages  TicketMessage[]

  @@index([userId, status])
  @@index([status, updatedAt])
  @@index([assignedToId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/// Internal staff notes on a learner (not visible to the user)
model StaffNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}


/// CMS static page (WordPress Pages)
model Page {
  id          String     @id @default(cuid())
  slug        String     @unique
  status      String     @default("draft")
  /// default | elementor
  template    String     @default("default")
  /// Elementor-like page builder JSON
  builderJson String     @default("{\"version\":1,\"sections\":[]}")
  /// Featured image
  coverUrl    String?
  /// Internal hero / banner
  bannerUrl   String?
  parentId    String?
  sortOrder   Int        @default(0)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Page?      @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Page[]     @relation("PageTree")
  i18n        PageI18n[]
  seo         SeoMeta?
}

model PageI18n {
  id      String @id @default(cuid())
  pageId  String
  locale  String
  title   String
  summary String @default("")
  bodyMdx String @default("")
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
}

/// Category / tag taxonomy (post_category | product_category | post_tag | product_tag)
model Term {
  id        String     @id @default(cuid())
  slug      String
  /// post_category | product_category | post_tag | product_tag
  taxonomy  String
  parentId  String?
  sortOrder Int        @default(0)
  /// Category / term thumbnail (WP-style)
  imageUrl  String?
  /// Default category for new posts/products (one per taxonomy)
  isDefault Boolean    @default(false)
  createdAt DateTime   @default(now())
  parent    Term?      @relation("TermTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Term[]     @relation("TermTree")
  i18n      TermI18n[]
  articles  ArticleTerm[]
  courses   CourseTerm[]

  @@unique([taxonomy, slug])
  @@index([taxonomy])
  @@index([parentId])
}

model TermI18n {
  id          String @id @default(cuid())
  termId      String
  locale      String
  name        String
  description String @default("")
  term        Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([termId, locale])
}

model ArticleTerm {
  articleId String
  termId    String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  term      Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([articleId, termId])
}

model CourseTerm {
  courseId String
  termId   String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term     Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([courseId, termId])
}

/// Media library item
model MediaItem {
  id             String   @id @default(cuid())
  url            String
  /// Relative disk key under uploads/ (e.g. 2026/07/abc.jpg)
  storageKey     String?
  /// Smush-optimized / WebP-friendly URL when available
  optimizedUrl   String?
  filename       String
  mimeType       String   @default("application/octet-stream")
  sizeBytes      Int      @default(0)
  originalBytes  Int      @default(0)
  width          Int?
  height         Int?
  alt            String   @default("")
  title          String   @default("")
  /// pending | optimized | skipped
  smushStatus    String   @default("pending")
  uploadedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
  @@index([smushStatus])
}

/// Comments on articles (moderated)
model Comment {
  id          String   @id @default(cuid())
  articleId   String?
  authorId    String?
  authorName  String?
  authorEmail String?
  body        String
  /// pending | approved | spam | trash
  status      String   @default("pending")
  parentId    String?
  createdAt   DateTime @default(now())
  article     Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parent      Comment? @relation("CommentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Comment[] @relation("CommentTree")

  @@index([articleId, status])
  @@index([status, createdAt])
}

model NavMenu {
  id        String        @id @default(cuid())
  /// header | footer | mobile
  location  String        @unique
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     NavMenuItem[]
}

model NavMenuItem {
  id        String  @id @default(cuid())
  menuId    String
  parentId  String?
  /// custom | page | article | course
  type      String  @default("custom")
  refId     String?
  url       String  @default("")
  labelJson String  @default("{}")
  sortOrder Int     @default(0)
  menu      NavMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent    NavMenuItem? @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  NavMenuItem[] @relation("MenuTree")

  @@index([menuId, sortOrder])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  /// percent | fixed
  discountType    String
  amount          Int
  currency        String    @default("IRT")
  maxUses         Int?
  usedCount       Int       @default(0)
  minAmountCents  Int       @default(0)
  expiresAt       DateTime?
  active          Boolean   @default(true)
  /// JSON: { courseIds?: string[], planIds?: string[] }
  scopeJson       String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  orders          Order[]
}

model OrderNote {
  id                 String   @id @default(cuid())
  orderId            String
  authorId           String?
  body               String
  isCustomerVisible  Boolean  @default(false)
  createdAt          DateTime @default(now())
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// Key/value site settings (general, reading, discussion, payments, …)
model SiteSetting {
  key       String   @id
  valueJson String   @default("{}")
  updatedAt DateTime @updatedAt
}


/// Wordfence-style security events & IP blocks
model SecurityEvent {
  id        String   @id @default(cuid())
  /// login_fail | otp_rate | blocked_request | scan | unlock | ban_ip | unban_ip
  type      String
  severity  String   @default("info")
  ip        String?
  phone     String?
  path      String?
  userAgent String?
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([ip, createdAt])
}

model BlockedIp {
  id        String    @id @default(cuid())
  ip        String    @unique
  reason    String    @default("")
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  createdBy String?

  @@index([expiresAt])
}

model LoginLockout {
  id           String   @id @default(cuid())
  phone        String
  ip           String?
  failCount    Int      @default(0)
  lockedUntil  DateTime?
  updatedAt    DateTime @updatedAt

  @@unique([phone])
  @@index([ip])
}


/// WooCommerce-style product attributes (e.g. Level, Language)
model ProductAttribute {
  id        String                 @id @default(cuid())
  slug      String                 @unique
  name      String
  type      String                 @default("select")
  orderBy   String                 @default("menu_order")
  hasArchives Boolean              @default(false)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  terms     ProductAttributeTerm[]
}

model ProductAttributeTerm {
  id          String           @id @default(cuid())
  attributeId String
  slug        String
  name        String
  description String           @default("")
  sortOrder   Int              @default(0)
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, slug])
  @@index([attributeId])
}

/// Appearance → Widgets areas (header/footer/sidebar)
model WidgetArea {
  id        String   @id @default(cuid())
  /// header | footer | sidebar | shop_sidebar
  location  String   @unique
  name      String
  /// JSON array of widgets {id,type,title,settings}
  widgetsJson String @default("[]")
  updatedAt DateTime @updatedAt
}
