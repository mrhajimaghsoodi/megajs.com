# MEGA JS API — local env

DATABASE_URL="file:./dev.db"
PORT=4000
NODE_ENV=development
JWT_SECRET=dev-only-change-me
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
# Notify Next.js to purge ISR cache after WP Rocket purge
WEB_REVALIDATE_URL=http://localhost:3000
REVALIDATE_SECRET=dev-revalidate-secret

# Local media uploads (WordPress-style Media Library)
# UPLOAD_DIR=./uploads
# UPLOAD_PUBLIC_BASE=/api/uploads

# Dev OTP returns `devCode` in API response when NODE_ENV !== production
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER=

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# ZARINPAL_MERCHANT_ID=
# ZARINPAL_CALLBACK_URL=http://localhost:4000/api/billing/zarinpal/callback

# STREAM_PROVIDER=
