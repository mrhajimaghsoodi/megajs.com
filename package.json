{
  "name": "megajs",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @megajs/api prisma:generate",
    "db:migrate": "pnpm --filter @megajs/api prisma:migrate",
    "db:seed": "pnpm --filter @megajs/api prisma:seed",
    "docs:dev": "echo 'See /docs'"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": "[\"prisma\",\"@prisma/client\",\"@prisma/engines\",\"esbuild\",\"sharp\",\"unrs-resolver\"]"
  }
}
